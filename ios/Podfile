# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # ──────────────────────────────────────────────────────────────────────────
  # Fix: Generate/Copy PDFium dSYMs into the Xcode archive for App Store.
  #
  # pdfrx 2.x bundles PDFium via a Swift Package Manager XCFramework.
  # Since the XCFramework binary zip does not ship pre-built .dSYM files,
  # archiving fails with:
  #   "The archive did not include a dSYM for the PDFium.framework"
  #
  # This Run Script Build Phase runs during `xcodebuild archive` (ACTION=install)
  # and generates `PDFium.framework.dSYM` directly from the embedded binary
  # into the archive's dSYMs directory using `dsymutil`.
  # ──────────────────────────────────────────────────────────────────────────
  require 'xcodeproj'
  project_path = File.join(File.dirname(__FILE__), 'Runner.xcodeproj')
  project = Xcodeproj::Project.open(project_path)
  runner_target = project.targets.find { |t| t.name == 'Runner' }

  if runner_target
    phase_name = '[pdfrx] Copy PDFium dSYMs'

    # Remove any previously added phase to avoid duplicates on each pod install
    runner_target.shell_script_build_phases.delete_if { |p| p.name == phase_name }

    phase = runner_target.new_shell_script_build_phase(phase_name)
    phase.shell_script = <<~'SHELL'
      # Generates PDFium.framework.dSYM into the archive dSYMs folder.
      # Only runs during xcodebuild archive (ACTION=install).
      if [ "${ACTION}" != "install" ]; then exit 0; fi

      # Locate the embedded PDFium binary
      BINARY="${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}/PDFium.framework/PDFium"
      if [ ! -f "${BINARY}" ]; then
        BINARY="${BUILT_PRODUCTS_DIR}/${FRAMEWORKS_FOLDER_PATH}/PDFium.framework/PDFium"
      fi
      if [ ! -f "${BINARY}" ]; then
        BINARY="${BUILT_PRODUCTS_DIR}/PDFium.framework/PDFium"
      fi

      if [ -f "${BINARY}" ]; then
        echo "Generating PDFium dSYM for ${BINARY} -> ${DWARF_DSYM_FOLDER_PATH}/PDFium.framework.dSYM..."
        mkdir -p "${DWARF_DSYM_FOLDER_PATH}"
        dsymutil "${BINARY}" -o "${DWARF_DSYM_FOLDER_PATH}/PDFium.framework.dSYM"
        echo "✅ PDFium.framework.dSYM generated successfully."
      else
        echo "warning: [pdfrx] PDFium binary not found at ${BINARY}"
      fi
    SHELL

    project.save
    puts "✅ [pdfrx] 'Copy PDFium dSYMs' build phase updated in Runner target."
  end
end

